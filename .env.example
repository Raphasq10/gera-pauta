# ==============================================================================
# GERA PAUTA — VARIÁVEIS DE AMBIENTE (EXEMPLO)
# Copie este arquivo para .env.local e preencha com suas credenciais reais.
# ==============================================================================

# VARIÁVEIS PÚBLICAS (Acessíveis pelo navegador — prefixo NEXT_PUBLIC_)
NEXT_PUBLIC_APP_NAME="Gera Pauta"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# SUPABASE (Banco de Dados & Autenticação)
# Obtenha em: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL="https://seu-projeto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-chave-anonima-publica"

# ==============================================================================
# VARIÁVEIS SECRETAS (Apenas no Servidor — NUNCA expor no GitHub)
# ==============================================================================

# SUPABASE CHAVE MESTRE (Para operações administrativas e webhooks)
SUPABASE_SERVICE_ROLE_KEY="sua-chave-secreta-service-role"

# IA DE PONTA GRATUITA (Para as 5 pautas de degustação)
# Obtenha em: https://console.groq.com/keys ou https://aistudio.google.com/app/apikey
GROQ_API_KEY=""
GEMINI_API_KEY=""

# STRIPE (Pagamentos e Assinaturas)
# Obtenha em: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_PRO=""
